<Project Sdk="Microsoft.NET.Sdk">

  <!-- Build tooling, not a layer of the model: this project holds the analysers that turn the
       engine's conventions into build errors. It ships with the compiler, not with the engine.
       netstandard2.0 because that is what Roslyn loads analysers as. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>EconomySimulation.Analyzers</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- RS2008 wants an AnalyzerReleases.md changelog. That is for analysers shipped as a
         NuGet package to strangers; these ship to one solution, in the same commit as the code
         they police. -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
