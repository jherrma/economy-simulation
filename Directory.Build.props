<Project>

  <!-- The guarantees C# was chosen for. See docs/LANGUAGE-CHOICE.md and spec/stories/01-01.
       These are not style preferences: each one turns a class of silent wrong number into a
       build failure or a crash. Relaxing any of them needs a recorded reason. -->
  <PropertyGroup>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>9999</WarningLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <!-- Integer overflow is a bug in a model whose primary invariant is a sum of longs.
         Wrapping silently would break V1 in a way that looks like an economic result. -->
    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
    <!-- Deliberately NOT set: InvariantGlobalization. CSV formatting must be invariant because
         the code says so, not because the runtime has no other cultures to get it wrong with. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AnalysisLevel>latest</AnalysisLevel>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

</Project>
