<Project Sdk="Microsoft.NET.Sdk">

  <!-- The campaign: every scenario over every seed, one process each, collected into one dataset.

       Nothing is differenced, averaged or plotted here. The campaign produces a dataset, not a
       result — the moment it starts computing the answer, the answer stops being something anyone
       can check against the runs it came from. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>EconomySimulation.Campaign</RootNamespace>
    <AssemblyName>economy-simulation-campaign</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EconomySimulation.Engine\EconomySimulation.Engine.csproj" />
    <!-- Not called into: spawned. The reference is here so that running the campaign cannot
         launch 150 children against a stale build of the runner. -->
    <ProjectReference Include="..\..\src\EconomySimulation.Runner\EconomySimulation.Runner.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\EconomySimulation.Analyzers\EconomySimulation.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
